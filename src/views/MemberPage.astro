---
import { Image } from 'astro:assets'
import LinkedInIcon from '~/icons/linkedin.svg'
import { formatName, localizedText, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import type { Member } from '~/lib/content'

interface Props {
  locale: Locale
  member: Member
}

const { locale, member } = Astro.props
const { firstName, lastName, picture, pictureAlt, linkedIn } = member.data
const name = formatName(locale, firstName, lastName)
const description = localizedText(locale, member.data.description, member.data.englishDescription)
const position = localizedText(locale, member.data.position, member.data.englishPosition)
---

<BaseLayout
  locale={locale}
  title={name}
  description={description || undefined}
  image={picture?.src}
>
  <div class="my-[5%] flex w-full justify-center">
    <article class="mx-5 w-full rounded-2xl bg-black bg-opacity-70 p-5 md:mx-auto md:w-3/5">
      <div class="flex flex-row flex-wrap justify-center space-x-5 md:justify-start">
        <div class="my-auto w-fit">
          {picture && (
            <Image
              src={picture}
              alt={pictureAlt ?? name}
              title={name}
              width={250}
              densities={[1, 2]}
              loading="eager"
              class="h-auto max-h-full rounded-xl border-2 border-white"
            />
          )}
        </div>
        <div class="mt-5 flex w-auto flex-col justify-center lg:mt-0">
          <h1 class="mb-5 text-3xl">{name}</h1>
          <p class="text-xl">{position}</p>
          {linkedIn && (
            <a
              href={linkedIn}
              target="_blank"
              rel="noopener"
              class="my-5 w-fit"
              aria-label={`${name} – LinkedIn`}
            >
              <LinkedInIcon aria-hidden="true" />
            </a>
          )}
        </div>
      </div>

      <div class="mt-10">
        <p class="text-justify text-xl">{description}</p>
      </div>
    </article>
  </div>
</BaseLayout>
