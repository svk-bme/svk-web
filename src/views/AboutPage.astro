---
import { getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { formatName, localePath, localizedText, t, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getMembers } from '~/lib/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const members = await getMembers()
const background = await getEntry('pictures', 'about-us-background')
if (!background) throw new Error('Missing src/content/pictures/about-us-background.yaml')
const bg = background.data.image
---

<BaseLayout locale={locale} title={t(locale, 'common.routes.about')} image={bg.src} withBanner>
  <div
    slot="banner"
    class="about-banner relative w-screen"
    style={`--aspect: ${bg.width / bg.height}`}
  >
    <Image
      src={bg}
      alt={background.data.alt ?? ''}
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="fixed w-screen overflow-y-hidden"
    />
  </div>

  <div class="mx-auto my-12 h-min w-[83%] gap-2 rounded-3xl bg-black/35 p-12 backdrop-blur-sm">
    <h1 class="pb-4 text-center text-3xl sm:text-4xl md:text-5xl 2xl:text-start">
      {t(locale, 'Members.mission.title')}
    </h1>
    <div class="text-md flex flex-col gap-4 text-justify leading-loose text-gray-300 sm:text-lg">
      <p>{t(locale, 'Members.mission.body0')}</p>
      <p>{t(locale, 'Members.mission.body1')}</p>
    </div>
  </div>
  <section class="pb-24" aria-label={t(locale, 'Members.title')}>
    <ul class="mx-auto flex w-[83%] flex-row flex-wrap justify-around gap-5">
      {members.map((member) => {
        const { firstName, lastName, picture, pictureAlt, position, englishPosition } = member.data
        const name = formatName(locale, firstName, lastName)
        return (
          <li>
            <a href={localePath(locale, `/member/${member.id}`)} class="block cursor-pointer">
              <div class="h-80 w-64 overflow-y-hidden rounded-md bg-black/35 backdrop-blur-sm transition-all hover:scale-105">
                <div class="h-2/3 p-1 pb-0">
                  {picture && (
                    <Image
                      src={picture}
                      alt={pictureAlt ?? name}
                      height={208}
                      densities={[1, 2]}
                      class="mx-auto h-full w-auto max-h-full rounded-full"
                    />
                  )}
                </div>
                <div class="flex h-1/3 flex-col justify-center text-center">
                  <h2 class="text-lg md:text-2xl">{name}</h2>
                  {position && (
                    <p class="text-md text-gray-400">
                      {localizedText(locale, position, englishPosition)}
                    </p>
                  )}
                </div>
              </div>
            </a>
          </li>
        )
      })}
    </ul>
  </section>
</BaseLayout>
