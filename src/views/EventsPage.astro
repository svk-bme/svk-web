---
import EventTile from '~/components/EventTile.astro'
import { t, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getEvents } from '~/lib/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { current, past } = await getEvents()
---

<BaseLayout locale={locale} title={t(locale, 'common.routes.events')}>
  <div class="w-screen px-[8.5%] text-center">
    <h1 class="my-8 text-2xl">{t(locale, 'events.current')}</h1>
    {current.length > 0 ? (
      <div class="mb-40 grid grid-cols-1 justify-items-center gap-10 text-left md:grid-cols-2">
        {current.map((event, i) => (
          <EventTile locale={locale} event={event} eager={i < 2} />
        ))}
      </div>
    ) : (
      <p class="text-center text-2xl">{t(locale, 'events.none')}</p>
    )}
    <h2 class="my-10 text-2xl">{t(locale, 'events.past')}</h2>
    <div class="mb-[10%] grid grid-cols-1 gap-5 text-left text-sm md:grid-cols-2 lg:grid-cols-3">
      {past.map((event, i) => (
        <EventTile locale={locale} event={event} eager={current.length === 0 && i < 3} />
      ))}
    </div>
  </div>
</BaseLayout>
