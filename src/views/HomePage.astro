---
import GoalIcon from '~/icons/goal.svg'
import PeopleIcon from '~/icons/people.svg'
import SvkLogoWithText from '~/icons/svk-logo-with-text.svg'
import TasksIcon from '~/icons/tasks.svg'
import Carousel from '~/components/Carousel.astro'
import { t, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCarouselEvents } from '~/lib/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const events = await getCarouselEvents()
const bubbles = [
  { icon: PeopleIcon, text: t(locale, 'Members.about0') },
  { icon: TasksIcon, text: t(locale, 'Members.about1') },
  { icon: GoalIcon, text: t(locale, 'Members.about2') },
]
// The partners section (logo marquee) is switched off, as it was on the old site.
---

<BaseLayout locale={locale} hideNavbarUntilScroll>
  <section class="h-fit -translate-y-20 items-center justify-center px-0">
    <div class="mx-auto flex h-screen w-full flex-col content-center justify-center gap-10">
      <div class="flex w-full flex-row justify-center">
        <div class="w-fit scale-[40%] md:scale-75 lg:scale-100">
          <SvkLogoWithText role="img" aria-label={t(locale, 'common.footer.svk')} />
        </div>
      </div>
      <div class="text-center">
        <h1 class="mb-6 text-2xl lg:text-6xl">{t(locale, 'Index.mainTitle').trim()}</h1>
        <p class="text-md text-cyan lg:text-2xl">{t(locale, 'Index.motto')}</p>
      </div>
    </div>
  </section>
  <section>
    <h2 class="text-center text-3xl md:translate-y-[200%] md:text-5xl">
      {t(locale, 'Index.events')}
    </h2>
    <Carousel locale={locale} events={events} />
  </section>
  <section>
    <div class="mx-auto flex h-min w-[83%] flex-col justify-center gap-5 py-24 lg:flex-row">
      {bubbles.map(({ icon: Icon, text }) => (
        <div class="relative mx-auto max-w-lg flex-1 flex-col justify-center gap-20 rounded-3xl bg-black bg-opacity-15 p-5 backdrop-blur-sm">
          <div class="relative mx-auto h-[70px] w-[70px]">
            <Icon aria-hidden="true" />
          </div>
          <div class="mx-auto my-2.5 h-5 w-0.5 bg-white" />
          <p class="basis-[100%] text-justify text-base sm:basis-[90%] md:text-lg lg:text-base xl:text-lg">
            {text}
          </p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
