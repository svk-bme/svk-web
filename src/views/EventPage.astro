---
import { Image } from 'astro:assets'
import EmailModal from '~/components/EmailModal.astro'
import EventInfo from '~/components/EventInfo.astro'
import { localizedText, t, type Locale } from '~/i18n'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { isCurrentEvent, type Event } from '~/lib/content'

interface Props {
  locale: Locale
  event: Event
}

const { locale, event } = Astro.props
const { image, imageAlt } = event.data
const title = localizedText(locale, event.data.title, event.data.englishTitle)
const description = localizedText(locale, event.data.description, event.data.englishDescription)
const available = isCurrentEvent(event)
---

<BaseLayout locale={locale} title={title} description={description || undefined} image={image?.src}>
  <div class="my-[5%] flex w-full justify-center">
    <article class="mx-5 w-full rounded-2xl bg-black bg-opacity-70 p-5 md:mx-auto md:w-3/5">
      <h1 class="mb-5 text-center text-3xl lg:hidden">{title}</h1>
      <div class="flex flex-row flex-wrap space-x-5">
        <div class="my-auto w-full lg:w-1/3">
          {image && (
            <Image
              src={image}
              alt={imageAlt ?? title}
              title={title}
              widths={[400, 700, 1000]}
              sizes="(min-width: 1024px) 20vw, 90vw"
              loading="eager"
              class="h-auto max-h-full w-full rounded-xl border-2 border-white"
            />
          )}
        </div>
        <div class="mt-5 flex w-auto flex-col lg:mt-0">
          <h1 class="mb-5 hidden text-3xl lg:block">{title}</h1>
          <EventInfo locale={locale} event={event} />
        </div>
      </div>
      <div class="mt-10">{description && <p class="text-justify text-xl">{description}</p>}</div>
      {available && (
        <div class="flex w-full justify-center">
          <button
            type="button"
            data-open-modal="event-application-modal"
            class="mx-auto my-5 h-10 min-w-20 rounded-xl bg-zinc-700 px-4 text-xl transition-opacity hover:opacity-80"
          >
            {t(locale, 'events.apply')}
          </button>
        </div>
      )}
    </article>
  </div>
  {available && (
    <EmailModal
      slot="modals"
      id="event-application-modal"
      locale={locale}
      title={t(locale, 'events.form.mainTitle')}
      text={t(locale, 'common.email.eventApplication')}
      subject={`${t(locale, 'events.form.mainTitle')}: ${title}`}
    />
  )}
</BaseLayout>
